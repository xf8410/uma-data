{"table": "race_jikkyo_comment", "total_rows": 384, "exported": 100, "columns": ["id", "group_id", "message", "voice", "per", "message_group", "omit_tag"], "data": [{"id": 1, "group_id": 100000, "message": "名勝負になる舞台は整いましたね", "voice": "%w_0.3|1000101", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 2, "group_id": 0, "message": "バ場が乾いているので\\n足元が滑るかもしれませんね", "voice": "1000201", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 3, "group_id": 100002, "message": "このくらいのバ場のほうが\\n合っているウマ娘もいますからね", "voice": "1000301", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 4, "group_id": 100003, "message": "このくらい引き締まったバ場ですと\\nスピードに乗りやすいですよ", "voice": "1000401", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 5, "group_id": 100004, "message": "天気、もってくれるといいですね", "voice": "%w_0.3|1000501", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 6, "group_id": 100005, "message": "日本のコースは水はけが良いですからね", "voice": "1000601", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 7, "group_id": 100006, "message": "雨が本格化したら\\n難しいレースになってしまいそうですね", "voice": "%w_0.3|1000701", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 8, "group_id": 100007, "message": "スピードは出しやすいですが\\n脚への負担が心配です", "voice": "%w_0.3|1000801", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 9, "group_id": 100008, "message": "ここまで重たいバ場だと\\n得意、不得意が出てきちゃいますね", "voice": "%w_0.3|1000901", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 10, "group_id": 100009, "message": "かなり苦労するバ場ですね\\nコース取りにも注意です", "voice": "1001001", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 11, "group_id": 100010, "message": "こんなに荒れていると\\nレース展開が読みにくいですよ", "voice": "%w_0.1|1001101", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 12, "group_id": 100011, "message": "これは相当走りにくそうなバ場状態ですね", "voice": "1001201", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 13, "group_id": 100012, "message": "雪がどれだけ影響するか、心配です", "voice": "1001301", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 14, "group_id": 100013, "message": "雪も考慮して走らないといけないですね", "voice": "1001401", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 15, "group_id": 100014, "message": "雪化粧と言えば聞こえはいいですが\\n走る娘たちにすればやっかいですね", "voice": "1001501", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 16, "group_id": 100015, "message": "この雪は敵か味方か\\nウマ娘たちの適性が試されます", "voice": "1001601", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 18, "group_id": 100016, "message": "気合充分！　いい顔してますね！", "voice": "1001801", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 19, "group_id": 100016, "message": "火花散らすデッドヒートに期待しましょう", "voice": "1001901", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 20, "group_id": 100016, "message": "私が一番期待しているウマ娘\\n気合い入れてほしいですね！", "voice": "1002001|1002002", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 22, "group_id": 100021, "message": "さすがスタートに定評のあるふたりですね", "voice": "1002201", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 23, "group_id": 100022, "message": "このスタートの良さが彼女の強さですね", "voice": "1002301", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 24, "group_id": 100022, "message": "完璧なスタートでしたね", "voice": "1002401", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 25, "group_id": 100024, "message": "みんな出方をうかがったのかもしれませんね", "voice": "1002501", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 26, "group_id": 100025, "message": "みんな集中してましたね\\n好レースが期待できそうです", "voice": "1002601", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 28, "group_id": 100027, "message": "出遅れた娘の巻き返しに期待しましょう", "voice": "1002801", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 43, "group_id": 100043, "message": "%h_player\\n軽やかな走りをしていますね", "voice": "%h_player|1004001", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 44, "group_id": 100043, "message": "%h_player\\n軽快にレースを運んでいますね", "voice": "%h_player|1004101", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 45, "group_id": 100044, "message": "いいライバル関係になりそうですね", "voice": "1004201", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 59, "group_id": 100059, "message": "まだこれからですよ\\n頑張ってほしいですね！", "voice": "1004601|1004602", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 60, "group_id": 100059, "message": "ちょっと厳しい位置ですが\\nここからの巻き返しに期待です", "voice": "1004603|1004604", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 61, "group_id": 100059, "message": "まだこれからですよ\\nここからの巻き返しに期待です", "voice": "1004601|1004604", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 62, "group_id": 100059, "message": "ちょっと厳しい位置ですが\\n頑張ってほしいですね！", "voice": "1004603|1004602", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 67, "group_id": 100066, "message": "互いに牽制しあっていますからね\\n仕掛けるタイミングで\\n明暗が分かれそうです", "voice": "1004801", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 68, "group_id": 100067, "message": "緊張感のあるいい展開ですね\\nただ、ペース配分には\\n気を付けたいところでしょうか", "voice": "1004901", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 70, "group_id": 100069, "message": "これは大胆な作戦！\\n完全に予想外でした！", "voice": "1005003|1005004", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 72, "group_id": 100069, "message": "これは大胆な作戦！\\n波乱の展開になりそうです！", "voice": "1005003|1005002", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 73, "group_id": 100072, "message": "%h_rank1、\\n彼女の脚質にはあっていますね", "voice": "%h_rank1|1005101", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 75, "group_id": 100074, "message": "この位置なら周囲の様子をうかがえます\\n冷静にレースを進めてますね", "voice": "1005301", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 76, "group_id": 100075, "message": "これはきっと作戦でしょう\\n彼女には爆発的な末脚があります！", "voice": "1005401", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 78, "group_id": 100077, "message": "最近、近くの神社への\\n恋愛祈願が流行っているらしいですよ", "voice": "1005601", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 79, "group_id": 100078, "message": "バ場状態を確認しながら走っている感じですね\\nまだ本気ではないですよ", "voice": "1005701", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 84, "group_id": 100083, "message": "ちょっと掛かり気味かもしれないです\\nひと息つけるといいですが", "voice": "1005901|1005902", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 85, "group_id": 100083, "message": "掛かってしまっているかもしれません\\n息を入れるタイミングがあればいいですが", "voice": "1005903|1005904", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 86, "group_id": 100083, "message": "ちょっと掛かり気味かもしれないです\\n息を入れるタイミングがあればいいですが", "voice": "1005901|1005904", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 87, "group_id": 100083, "message": "掛かってしまっているかもしれません\\nひと息つけるといいですが", "voice": "1005903|1005902", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 88, "group_id": 100087, "message": "ちょっと苦しいけど大丈夫\\nここからが彼女の実力の見せどころです！", "voice": "%w_0.05|1006001", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 89, "group_id": 100088, "message": "これだけ密集していると\\nまぎれがありそうですね", "voice": "1006101", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 90, "group_id": 100089, "message": "仕掛けどころの難しいレースになりそうですね", "voice": "1006201", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 121, "group_id": 100120, "message": "焦っているみたいですね\\n前との距離が気になるのでしょうか", "voice": "2008701", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 222, "group_id": 100221, "message": "勝負所、最後の直線へと駆けていきます！", "voice": "1017601", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 256, "group_id": 100276, "message": "ちょっと前に出ましたね", "voice": "2021001", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 1040, "group_id": 100000, "message": "充分に実力を出せるレースとなりそうですね", "voice": "%w_0.1|1008201", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 1041, "group_id": 100000, "message": "各ウマ娘の好走が期待できます", "voice": "%w_0.1|1008301", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 1042, "group_id": 100001, "message": "バ場が乾いていますから\\n力のいるレースになりそうですね", "voice": "1008401", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 1043, "group_id": 100001, "message": "ダート巧者の実力が\\n遺憾なく発揮できそうですね", "voice": "1008501", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 1044, "group_id": 100021, "message": "このふたりのレース運びに注目ですね", "voice": "1008601", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 1045, "group_id": 100021, "message": "ふたりのペースに\\n後続がどう対応するか注目です", "voice": "1008701", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 1046, "group_id": 100025, "message": "これは位置取りが熾烈になりそうですね", "voice": "1008801", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 1047, "group_id": 100025, "message": "誰が先頭に抜け出すか、注目しましょう", "voice": "1008901", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 1050, "group_id": 100044, "message": "ふたりがレースを作りそうですね", "voice": "1009301", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 1051, "group_id": 100044, "message": "ハイペースで流れる展開もありえますね", "voice": "1009401", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 1052, "group_id": 100075, "message": "直線勝負に賭けているんでしょう\\n終盤に期待です！", "voice": "1009501", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 1053, "group_id": 100088, "message": "前に抜け出すのは容易じゃなさそうです", "voice": "1009601", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 1054, "group_id": 100088, "message": "お互いに牽制し合っているようですね", "voice": "1009701", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 1055, "group_id": 100089, "message": "各自、自分のペースを保っているようですね", "voice": "%w_0.1|1009801", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 1056, "group_id": 100089, "message": "後方のウマ娘が差し返せるのか\\n気になる開きです", "voice": "1009901", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 1057, "group_id": 100221, "message": "内からくるか、外からくるか！\\n最後の局面です！", "voice": "1010001", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 1058, "group_id": 100221, "message": "ウマ娘たちがどう動くか\\n目が離せません！", "voice": "1010101", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 1059, "group_id": 100221, "message": "ここからスパート！\\n一気にレースが動きます！", "voice": "1010201", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 1060, "group_id": 100276, "message": "スタミナを切らさないか心配です", "voice": "1010301", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 1061, "group_id": 100276, "message": "冷静さを取り戻せるといいのですが", "voice": "1010401", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 1062, "group_id": 112592, "message": "これだけ密集していると\\nまぎれがありそうですね", "voice": "1006101", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 1063, "group_id": 112592, "message": "前に抜け出すのは容易じゃなさそうです", "voice": "1009601", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 2001, "group_id": 150001, "message": "ダート界のスター誕生を期待したいですね", "voice": "%w_0.3|0000001", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 2002, "group_id": 150002, "message": "春のスプリント王候補筆頭はズバリこの娘ですね", "voice": "%w_0.3|0000002", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 2003, "group_id": 150003, "message": "春の三冠・一冠目を制して\\n実力を証明してほしいですね", "voice": "%w_0.3|0000003", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 2004, "group_id": 150004, "message": "トリプルティアラの一冠目を制して\\nみごと桜の女王となってほしいですね", "voice": "%w_0.3|0000004", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 2005, "group_id": 150005, "message": "クラシック三冠の一冠目を制する\\n最も「はやい」ウマ娘は彼女かもしれませんね", "voice": "%w_0.3|0000005", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 2006, "group_id": 150006, "message": "現役最強の実力を見せつけて\\n春の盾を手にしてほしいですね", "voice": "%w_0.3|0000006", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 2007, "group_id": 150007, "message": "新緑の府中で新生マイル王の座を\\n手にしてほしいですね", "voice": "%w_0.3|0000007", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 2008, "group_id": 150008, "message": "勝利の女神をあっと言わせる走りを\\n見せてほしいですね", "voice": "%w_0.3|0000008", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 2009, "group_id": 150009, "message": "トリプルティアラの二冠目\\n樫の女王の栄冠を勝ち取ってほしいですね", "voice": "%w_0.3|0000009", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 2010, "group_id": 150010, "message": "みごと勝利してダービーウマ娘の\\n夢を掴んでほしいですね", "voice": "%w_0.3|0000010", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 2011, "group_id": 150011, "message": "そのスピードを見せつけて\\n春のマイル王に輝いてほしいですね", "voice": "%w_0.3|0000011", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 2012, "group_id": 150012, "message": "もっとも多くのファンの夢を背負っていますから\\nみごとグランプリウマ娘に輝いてほしいですね", "voice": "%w_0.3|0000012", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 2013, "group_id": 150013, "message": "人気に応えて秋のスプリント王者の座を\\n掴んでほしいですね", "voice": "%w_0.3|0000013", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 2014, "group_id": 150014, "message": "トリプルティアラの三冠目\\nその素晴らしい走りを開花させてほしいですね", "voice": "%w_0.3|0000014", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 2015, "group_id": 150015, "message": "クラシック三冠路線の終着点\\nここを勝って世代最強を証明してほしいですね", "voice": "%w_0.3|0000015", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 2016, "group_id": 150016, "message": "中距離路線の頂点に立つ走りで\\n秋の盾を手にしてほしいですね", "voice": "%w_0.3|0000016", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 2017, "group_id": 150017, "message": "女王の栄冠を掴むだけの\\n実力は充分に持っていますよ", "voice": "%w_0.3|0000017", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 2018, "group_id": 150018, "message": "現役屈指のスピードで\\n最強のマイル王に輝いてほしいですね", "voice": "%w_0.3|0000018", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 2019, "group_id": 150019, "message": "日本を代表する圧巻の走りを\\n見せつけてほしいですね", "voice": "%w_0.3|0000019", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 2020, "group_id": 150020, "message": "ダート最強の走りで\\nみごとチャンピオンに輝いてほしいですね", "voice": "%w_0.3|0000020", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 2021, "group_id": 150021, "message": "来年のティアラ路線に向けて\\n新たな女王の誕生を期待したいですね", "voice": "%w_0.3|0000021", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 2022, "group_id": 150022, "message": "来年のクラシック路線を見据えて\\n力を示してほしいですね", "voice": "%w_0.3|0000022", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 2023, "group_id": 150023, "message": "今年最後の大一番で名実ともに\\n最強のグランプリウマ娘となってほしいですね", "voice": "%w_0.3|0000023", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 2024, "group_id": 150024, "message": "クラシック路線につながる\\n大きな一歩を踏み出してほしいですね", "voice": "%w_0.3|0000024", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 2025, "group_id": 150025, "message": "上半期ダート路線の総決算\\n王者にふさわしい走りを見せてほしいですね", "voice": "%w_0.3|0000025", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 2026, "group_id": 150026, "message": "ここ大井で、ダート界の新星誕生を期待したいですね", "voice": "%w_0.3|0000026", "per": 100, "message_group": 0, "omit_tag": 0}, {"id": 2027, "group_id": 150027, "message": "ダート界のヒロインとして輝く\\n素晴らしい走りを見せてほしいですね", "voice": "%w_0.3|0000027", "per": 100, "message_group": 0, "omit_tag": 0}]}