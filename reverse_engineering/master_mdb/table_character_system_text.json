{"table": "character_system_text", "total_rows": 32561, "exported": 100, "columns": ["character_id", "voice_id", "text", "cue_sheet", "cue_id", "motion_set", "scene", "use_gallery", "card_id", "lip_sync_data", "lip_sync_flag", "gender", "motion_second_set", "motion_second_start", "gallery_key_usage_condition", "prop_system_text_id", "start_date"], "data": [{"character_id": 1001, "voice_id": 11, "text": "Cygames", "cue_sheet": "snd_voi_title_100100", "cue_id": 0, "motion_set": 0, "scene": 0, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_title_100100_0000", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 12, "text": "ウマ娘、プリティーダービー！", "cue_sheet": "snd_voi_title_100100", "cue_id": 1, "motion_set": 0, "scene": 0, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_title_100100_0001", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 10000, "text": "ライバルのみんなと一緒に…\r\n私、必ず強くなりますっ。", "cue_sheet": "snd_voi_home_100100", "cue_id": 0, "motion_set": 2009, "scene": 1, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_home_100100_0000", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 2, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 10001, "text": "私たちの夢は、日本一のウマ娘っ！\r\n一緒に叶えましょうね、\r\nトレーナーさん！", "cue_sheet": "snd_voi_home_100100", "cue_id": 1, "motion_set": 1001017, "scene": 1, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_home_100100_0001", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 2, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 10002, "text": "今度また、ご近所食べ歩きツアーに\r\n行きましょうねっ♪", "cue_sheet": "snd_voi_home_100100", "cue_id": 2, "motion_set": 1001002, "scene": 1, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_home_100100_0002", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 2, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 10003, "text": "あけましておめでとうございます！\r\n正月太りには…気を付けますね！", "cue_sheet": "snd_voi_home_100100", "cue_id": 3, "motion_set": 2002, "scene": 1, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_home_100100_0003", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 10004, "text": "ハッピーバレンタインですっ！\r\nいつものお礼に…チョコ、どうぞ！", "cue_sheet": "snd_voi_home_100100", "cue_id": 4, "motion_set": 1001007, "scene": 1, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_home_100100_0004", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 10005, "text": "チョコ、お母ちゃん直伝のレシピで\r\n手作りしちゃいました！えへへ。\r\nもらってくれますか…？", "cue_sheet": "snd_voi_home_100100", "cue_id": 5, "motion_set": 1001808, "scene": 1, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_home_100100_0005", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 2, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 10006, "text": "星を眺めたくなる夜ですね～！\r\n晴れるといいなぁ…。", "cue_sheet": "snd_voi_home_100100", "cue_id": 6, "motion_set": 8000, "scene": 1, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_home_100100_0006", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 10007, "text": "なんだかお菓子の匂いでいっぱい\r\nだと思ったら…ハロウィンですか！\r\nおいしい行事は大歓迎です～！", "cue_sheet": "snd_voi_home_100100", "cue_id": 7, "motion_set": 1001007, "scene": 1, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_home_100100_0007", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 10008, "text": "お母ちゃんサンタのおひげが\r\n取れちゃったこと、\r\n思い出すなぁ…ふふふっ。", "cue_sheet": "snd_voi_home_100100", "cue_id": 8, "motion_set": 1001001, "scene": 1, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_home_100100_0008", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 10009, "text": "メリークリスマス、ですっ。\r\n牛乳たっぷりのあったかシチュー、\r\n一緒に食べませんか？", "cue_sheet": "snd_voi_home_100100", "cue_id": 9, "motion_set": 1001007, "scene": 1, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_home_100100_0009", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 2, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 10010, "text": "今年もあっという間でしたね。\r\n来年の私は…もっともっと、\r\n強くなれるといいな！", "cue_sheet": "snd_voi_home_100100", "cue_id": 10, "motion_set": 1001017, "scene": 1, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_home_100100_0010", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 10011, "text": "お誕生日おめでとうございます！\r\nカフェテリアのケーキ、\r\nよければ食べに行きませんか？", "cue_sheet": "snd_voi_home_100100", "cue_id": 11, "motion_set": 8001, "scene": 1, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_home_100100_0011", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 1, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 10012, "text": "お誕生日おめでとうございますっ♪\r\nえへへ…こうしてお祝いできるの、\r\nなんだか幸せです。", "cue_sheet": "snd_voi_home_100100", "cue_id": 12, "motion_set": 1001007, "scene": 1, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_home_100100_0012", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 1, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 10013, "text": "朝からお母ちゃんにもみんなにも\r\nおめでとうって言ってもらえて…\r\nうぅ、すごく幸せな誕生日です～！", "cue_sheet": "snd_voi_home_100100", "cue_id": 13, "motion_set": 1001002, "scene": 1, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_home_100100_0013", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 10014, "text": "お祝いありがとうございます！\r\n私、もっともっと成長しますから…\r\n隣で見ていてくださいねっ。", "cue_sheet": "snd_voi_home_100100", "cue_id": 14, "motion_set": 2002, "scene": 1, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_home_100100_0014", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 2, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 10015, "text": "トレーナーさんっ！\r\nお知らせが届いてるみたいですよ！", "cue_sheet": "snd_voi_home_100100", "cue_id": 15, "motion_set": 8000, "scene": 1, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_home_100100_0015", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 10016, "text": "プレゼントがありますね！\r\n中身はなにかな～、えへへ！", "cue_sheet": "snd_voi_home_100100", "cue_id": 16, "motion_set": 1001000, "scene": 1, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_home_100100_0016", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 10017, "text": "達成済みのミッションが\r\nあるみたいですね！\r\nよーし、私もがんばらないと！", "cue_sheet": "snd_voi_home_100100", "cue_id": 17, "motion_set": 2009, "scene": 1, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_home_100100_0017", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 10018, "text": "もうすぐイベントが始まる\r\nみたいです！楽しみですね～！", "cue_sheet": "snd_voi_home_100100", "cue_id": 18, "motion_set": 1001007, "scene": 1, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_home_100100_0018", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 10019, "text": "イベント開催中…！？\r\nわあっ、参加してみませんか！？", "cue_sheet": "snd_voi_home_100100", "cue_id": 19, "motion_set": 1001000, "scene": 1, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_home_100100_0019", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614654000}, {"character_id": 1001, "voice_id": 10025, "text": "これは、地元でお母ちゃんと\r\n一緒に選んだ服なんです！都会に\r\n合わせてオシャレしたんですよ！", "cue_sheet": "snd_voi_home_100100", "cue_id": 25, "motion_set": 1001008, "scene": 1, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_home_100100_0025", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 4, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 10026, "text": "スズカさんが私服を褒めてくれて…\r\nえへへ…。お揃いをプレゼント\r\nしたら、着てくれますかね…？", "cue_sheet": "snd_voi_home_100100", "cue_id": 26, "motion_set": 1001002, "scene": 1, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_home_100100_0026", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 4, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 10027, "text": "トレーナーさんのオススメの場所\r\nとかってありますか？よかったら\r\n気分転換に遊びに行きましょう！", "cue_sheet": "snd_voi_home_100100", "cue_id": 27, "motion_set": 1001007, "scene": 1, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_home_100100_0027", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 4, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 20000, "text": "ふぅ…体が少し重いです～…。", "cue_sheet": "snd_voi_training_100100", "cue_id": 0, "motion_set": 1001809, "scene": 2, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_training_100100_0000", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 20001, "text": "トレーナーさん～…すみません、\r\n少し休んでもいいでしょうか～…？", "cue_sheet": "snd_voi_training_100100", "cue_id": 1, "motion_set": 1001811, "scene": 2, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_training_100100_0001", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 20002, "text": "おぉぉっ…！\r\n今ならなんでもできる気がします！", "cue_sheet": "snd_voi_training_100100", "cue_id": 2, "motion_set": 1001017, "scene": 2, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_training_100100_0002", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 20003, "text": "走りたくて走りたくて\r\nうずうずしちゃいますっ！", "cue_sheet": "snd_voi_training_100100", "cue_id": 3, "motion_set": 1001002, "scene": 2, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_training_100100_0003", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 20004, "text": "なんだか調子がいい気がします！", "cue_sheet": "snd_voi_training_100100", "cue_id": 4, "motion_set": 2009, "scene": 2, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_training_100100_0004", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 20005, "text": "トレーナーさんっ！\r\nさぁ、次はどうしましょうか！？", "cue_sheet": "snd_voi_training_100100", "cue_id": 5, "motion_set": 9, "scene": 2, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_training_100100_0005", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 20006, "text": "よーし、\r\nトレーニングがんばるぞ～！", "cue_sheet": "snd_voi_training_100100", "cue_id": 6, "motion_set": 1001017, "scene": 2, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_training_100100_0006", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 20007, "text": "メニューはどうしますか？", "cue_sheet": "snd_voi_training_100100", "cue_id": 7, "motion_set": 1, "scene": 2, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_training_100100_0007", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 20008, "text": "うーん…\r\nちょっぴり力が出ません…。", "cue_sheet": "snd_voi_training_100100", "cue_id": 8, "motion_set": 1001811, "scene": 2, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_training_100100_0008", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 20009, "text": "はぁ…あっ、すみません。\r\nちょっと元気が出なくて…。", "cue_sheet": "snd_voi_training_100100", "cue_id": 9, "motion_set": 1001812, "scene": 2, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_training_100100_0009", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 20010, "text": "うぅ、体に力が入りません～…。", "cue_sheet": "snd_voi_training_100100", "cue_id": 10, "motion_set": 8007, "scene": 2, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_training_100100_0010", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 20011, "text": "悪いことばっかり考えちゃいます…\r\nはあぁぁ～…。", "cue_sheet": "snd_voi_training_100100", "cue_id": 11, "motion_set": 1001809, "scene": 2, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_training_100100_0011", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 20021, "text": "あっ、今回もレースに出ますか…？\r\nちょっと続いちゃってますけど…\r\nいえ、でもがんばります！", "cue_sheet": "snd_voi_training_100100", "cue_id": 12, "motion_set": 7, "scene": 2, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_training_100100_0012", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 20022, "text": "あ、あの～…今回はレースじゃなく\r\nお休みさせてもらえませんか…？", "cue_sheet": "snd_voi_training_100100", "cue_id": 13, "motion_set": 5007, "scene": 2, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_training_100100_0013", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 20023, "text": "早く早く、レースがしたいです！\r\n今なら思いっきり力が出せます！", "cue_sheet": "snd_voi_training_100100", "cue_id": 14, "motion_set": 1001002, "scene": 2, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_training_100100_0014", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 20024, "text": "調整はバッチリですねっ！\r\nあとは、本番で勝つだけです！", "cue_sheet": "snd_voi_training_100100", "cue_id": 15, "motion_set": 2009, "scene": 2, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_training_100100_0015", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 20025, "text": "日本一の夢に向かって、\r\n全力疾走してきますねっ！", "cue_sheet": "snd_voi_training_100100", "cue_id": 16, "motion_set": 1001017, "scene": 2, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_training_100100_0016", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 20026, "text": "うんっ、いい感じです！\r\n目標達成目指してがんばりますね！", "cue_sheet": "snd_voi_training_100100", "cue_id": 17, "motion_set": 2, "scene": 2, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_training_100100_0017", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 20027, "text": "ふふっ、体が軽いです！\r\nいつも以上の力が出せるかも…！", "cue_sheet": "snd_voi_training_100100", "cue_id": 18, "motion_set": 1001007, "scene": 2, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_training_100100_0018", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 20028, "text": "大事なレース、\r\nばっちりがんばれそうです！", "cue_sheet": "snd_voi_training_100100", "cue_id": 19, "motion_set": 9, "scene": 2, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_training_100100_0019", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 20029, "text": "いよいよレースですね。\r\n1着目指してがんばります！", "cue_sheet": "snd_voi_training_100100", "cue_id": 20, "motion_set": 2009, "scene": 2, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_training_100100_0020", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 20030, "text": "落ち着いて、いつも通りの\r\n力が出せるように\r\nがんばってきますね！", "cue_sheet": "snd_voi_training_100100", "cue_id": 21, "motion_set": 1001001, "scene": 2, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_training_100100_0021", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 20031, "text": "き、緊張してきちゃった…。\r\n深呼吸、深呼吸…！", "cue_sheet": "snd_voi_training_100100", "cue_id": 22, "motion_set": 1001811, "scene": 2, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_training_100100_0022", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 20032, "text": "大丈夫、大丈夫…！\r\nと、とにかく思いきり\r\n走ってきますっ！", "cue_sheet": "snd_voi_training_100100", "cue_id": 23, "motion_set": 1001812, "scene": 2, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_training_100100_0023", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 20033, "text": "気合いが足りないぃ～…！\r\n背中叩いてもらえませんか！？", "cue_sheet": "snd_voi_training_100100", "cue_id": 24, "motion_set": 7, "scene": 2, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_training_100100_0024", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 20034, "text": "不安だなんて言ってられませんね。\r\nがんばらなくっちゃ…！", "cue_sheet": "snd_voi_training_100100", "cue_id": 25, "motion_set": 3, "scene": 2, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_training_100100_0025", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 20035, "text": "みなさん強そうですね…。\r\nでも、やれるだけやってきます…！", "cue_sheet": "snd_voi_training_100100", "cue_id": 26, "motion_set": 5005, "scene": 2, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_training_100100_0026", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 20036, "text": "もっと調整がんばればよかった～。\r\nと、とにかく行ってきますね！", "cue_sheet": "snd_voi_training_100100", "cue_id": 27, "motion_set": 7, "scene": 2, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_training_100100_0027", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 20037, "text": "勝てるかなぁ…。\r\nううん、不安になってちゃダメ…！", "cue_sheet": "snd_voi_training_100100", "cue_id": 28, "motion_set": 1001809, "scene": 2, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_training_100100_0028", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 20038, "text": "始めますっ！", "cue_sheet": "snd_voi_training_100100", "cue_id": 29, "motion_set": 0, "scene": 2, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_training_100100_0029", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 20039, "text": "がんばります！", "cue_sheet": "snd_voi_training_100100", "cue_id": 30, "motion_set": 0, "scene": 2, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_training_100100_0030", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 20040, "text": "行きますっ！", "cue_sheet": "snd_voi_training_100100", "cue_id": 31, "motion_set": 0, "scene": 2, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_training_100100_0031", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 20041, "text": "集中、集中…！", "cue_sheet": "snd_voi_training_100100", "cue_id": 32, "motion_set": 0, "scene": 2, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_training_100100_0032", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 20042, "text": "あれ？", "cue_sheet": "snd_voi_training_100100", "cue_id": 33, "motion_set": 0, "scene": 2, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_training_100100_0033", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 20043, "text": "う～ん…。", "cue_sheet": "snd_voi_training_100100", "cue_id": 34, "motion_set": 0, "scene": 2, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_training_100100_0034", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 20046, "text": "楽しみです～！", "cue_sheet": "snd_voi_training_100100", "cue_id": 37, "motion_set": 0, "scene": 2, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_training_100100_0037", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 20047, "text": "海だぁ～！", "cue_sheet": "snd_voi_training_100100", "cue_id": 38, "motion_set": 0, "scene": 2, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_training_100100_0038", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 20049, "text": "トレーナーさんのおかげで成長できました！", "cue_sheet": "snd_voi_training_100100", "cue_id": 63, "motion_set": 0, "scene": 2, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_training_100100_0063", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 20050, "text": "トレーナーさん、ありがとうございました！", "cue_sheet": "snd_voi_training_100100", "cue_id": 64, "motion_set": 0, "scene": 2, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_training_100100_0064", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 30000, "text": "1着は逃しちゃいました…でも嬉しいですっ！", "cue_sheet": "snd_voi_race_100100", "cue_id": 0, "motion_set": 0, "scene": 3, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_race_100100_0000", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 30001, "text": "1着まであと少し…がんばらなきゃ！", "cue_sheet": "snd_voi_race_100100", "cue_id": 1, "motion_set": 0, "scene": 3, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_race_100100_0001", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 30002, "text": "次はもっといい走りがしたいですっ…！", "cue_sheet": "snd_voi_race_100100", "cue_id": 2, "motion_set": 0, "scene": 3, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_race_100100_0002", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 30003, "text": "うぅぅ～、やっちゃったぁ～…！", "cue_sheet": "snd_voi_race_100100", "cue_id": 3, "motion_set": 0, "scene": 3, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_race_100100_0003", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 60000, "text": "笑顔、笑顔…！わわ、もう出番！？", "cue_sheet": "snd_voi_live_100100", "cue_id": 0, "motion_set": 1001017, "scene": 4, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_live_100100_0000", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 60001, "text": "すぅーっ、はぁぁ～…い、行ってきます！", "cue_sheet": "snd_voi_live_100100", "cue_id": 1, "motion_set": 1001821, "scene": 4, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_live_100100_0001", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 23015, "text": "がんばります！", "cue_sheet": "snd_voi_training_100100", "cue_id": 30, "motion_set": 1, "scene": 2, "use_gallery": 0, "card_id": 0, "lip_sync_data": "snd_voi_training_100100_0030", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1719370800}, {"character_id": 1001, "voice_id": 100000, "text": "行ってきます！", "cue_sheet": "snd_voi_outgame_100100", "cue_id": 6, "motion_set": 0, "scene": 7, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_outgame_100100_0006", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1725937200}, {"character_id": 1001, "voice_id": 100001, "text": "ただいま戻りました！", "cue_sheet": "snd_voi_outgame_100100", "cue_id": 7, "motion_set": 0, "scene": 7, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_outgame_100100_0007", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1725937200}, {"character_id": 1001, "voice_id": 70001, "text": "『日本一のウマ娘になる』って\r\nどういうことなのか…\r\n私、ようやくわかりました！", "cue_sheet": "snd_voi_outgame_100100", "cue_id": 1, "motion_set": 1001003, "scene": 7, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_outgame_100100_0001", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 8001, "motion_second_start": 3500, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 90000, "text": "おはようございますっ！\r\n今日もよろしくお願いしますね、\r\nトレーナーさん！", "cue_sheet": "snd_voi_home_100101", "cue_id": 0, "motion_set": 1001001, "scene": 1, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_home_100101_0000", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 90001, "text": "日本一のウマ娘を目指して！\r\n今日も1日、けっぱるべ～！", "cue_sheet": "snd_voi_home_100101", "cue_id": 1, "motion_set": 2009, "scene": 1, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_home_100101_0001", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 90002, "text": "トレーナーさん、こんにちは～！\r\n午後もがんばっていきましょうね。", "cue_sheet": "snd_voi_home_100101", "cue_id": 2, "motion_set": 8002, "scene": 1, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_home_100101_0002", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 90003, "text": "待ってました～！\r\nお昼ご飯もいっぱい食べましたし、\r\n思いっきり体を動かしましょう！", "cue_sheet": "snd_voi_home_100101", "cue_id": 3, "motion_set": 1001000, "scene": 1, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_home_100101_0003", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 90004, "text": "ふわあぁ～…はっ！？\r\nね、寝てません、寝てませんよっ！", "cue_sheet": "snd_voi_home_100101", "cue_id": 4, "motion_set": 1001816, "scene": 1, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_home_100101_0004", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 90005, "text": "今日も1日、お疲れ様です。\r\nそろそろ寝る準備しようかなぁ。", "cue_sheet": "snd_voi_home_100101", "cue_id": 5, "motion_set": 8000, "scene": 1, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_home_100101_0005", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 90006, "text": "最近あったかくなってきましたね！\r\n今度のお休みに、ちょっと遠くまで\r\nお散歩しに行こうかなぁ…。", "cue_sheet": "snd_voi_home_100101", "cue_id": 6, "motion_set": 1001007, "scene": 1, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_home_100101_0006", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 90007, "text": "ふえぇ、今日も暑いですねぇ…。\r\nアイスの食べ過ぎに注意しないと！", "cue_sheet": "snd_voi_home_100101", "cue_id": 7, "motion_set": 1001811, "scene": 1, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_home_100101_0007", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 90008, "text": "あ、トレーナーさん！さっき\r\n石焼き芋の屋台を見つけたんです！\r\n今度絶対食べに行きましょうね…！", "cue_sheet": "snd_voi_home_100101", "cue_id": 8, "motion_set": 1001018, "scene": 1, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_home_100101_0008", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 90009, "text": "トレーナーさん！お友だちに\r\nカイロをもらったんですけど…\r\nよければお1つ、いかがですか？", "cue_sheet": "snd_voi_home_100101", "cue_id": 9, "motion_set": 8000, "scene": 1, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_home_100101_0009", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 91000, "text": "さっき、マルゼンさんと\r\nお話できちゃったんです！\r\nやっぱり素敵な方ですね～！", "cue_sheet": "snd_voi_home_100101", "cue_id": 10, "motion_set": 1001002, "scene": 1, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_home_100101_0010", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 91001, "text": "お母ちゃんから野菜がいっぱい\r\n届いたんですよ！\r\n今度おすそ分けしますね。", "cue_sheet": "snd_voi_home_100101", "cue_id": 11, "motion_set": 2001, "scene": 1, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_home_100101_0011", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 91002, "text": "ふわぁ…昨日、ついつい夜中まで\r\nスズカさんとお喋りしちゃって…。\r\nえへへ、楽しかったな～…。", "cue_sheet": "snd_voi_home_100101", "cue_id": 12, "motion_set": 1001814, "scene": 1, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_home_100101_0012", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 91003, "text": "おいしい～って思うと、ついつい\r\nたくさん食べちゃうんですよね～。\r\nえへへ…。", "cue_sheet": "snd_voi_home_100101", "cue_id": 13, "motion_set": 1001813, "scene": 1, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_home_100101_0013", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 91004, "text": "トレセン学園って本当に広いです。\r\n私、そのうち遭難しちゃいそう…！", "cue_sheet": "snd_voi_home_100101", "cue_id": 14, "motion_set": 1001016, "scene": 1, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_home_100101_0014", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 91005, "text": "さっき後輩の子に『ファンです！』\r\nって言われちゃいました！\r\nはわわ…こんなこともあるんだ！", "cue_sheet": "snd_voi_home_100101", "cue_id": 15, "motion_set": 1001011, "scene": 1, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_home_100101_0015", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 91006, "text": "この服、着てるとなんだか体が\r\n軽く思えるんです！北海道まで\r\n走って行けちゃいそう…！", "cue_sheet": "snd_voi_home_100101", "cue_id": 16, "motion_set": 1001018, "scene": 1, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_home_100101_0016", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 91007, "text": "この衣装が、いつか日本一の\r\n証になるまで…！\r\n私、走っていきたいですっ！", "cue_sheet": "snd_voi_home_100101", "cue_id": 17, "motion_set": 1001017, "scene": 1, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_home_100101_0017", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 91008, "text": "お母ちゃんに勝負服の写真を\r\n送ったら、すぐ電話が来ました！\r\nふふ…ずびー！って泣いてました。", "cue_sheet": "snd_voi_home_100101", "cue_id": 18, "motion_set": 1001813, "scene": 1, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_home_100101_0018", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 91009, "text": "今朝はエルちゃんたちと一緒に\r\n朝トレしてきたんですよ！\r\nえへへ、スッキリしましたっ。", "cue_sheet": "snd_voi_home_100101", "cue_id": 19, "motion_set": 1001018, "scene": 1, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_home_100101_0019", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 91010, "text": "うぅ、午前の授業の小テストで\r\n赤点取っちゃいました～…！\r\nまたグラスちゃんに教わらなきゃ。", "cue_sheet": "snd_voi_home_100101", "cue_id": 20, "motion_set": 1001811, "scene": 1, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_home_100101_0020", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 91011, "text": "なんで夜って、無性に甘いものが\r\n食べたくなるんでしょう…。うぅ、\r\nにんじんが頭の中を踊ってます～！", "cue_sheet": "snd_voi_home_100101", "cue_id": 21, "motion_set": 1001812, "scene": 1, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_home_100101_0021", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 91012, "text": "ふぁっ…くしゅん！\r\nあれぇ、なんで最近こんなに\r\nくしゃみが出るのかな…？", "cue_sheet": "snd_voi_home_100101", "cue_id": 22, "motion_set": 1001800, "scene": 1, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_home_100101_0022", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 7, "motion_second_start": 1600, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 91013, "text": "くんくん…あれ、雨の匂い…？\r\n暑さを和らげてくれる、\r\n恵みの雨ですねっ！", "cue_sheet": "snd_voi_home_100101", "cue_id": 23, "motion_set": 8010, "scene": 1, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_home_100101_0023", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 91014, "text": "秋は、なんだか寂しい気持ちに\r\nなっちゃいますね。\r\nお母ちゃん元気かなぁ…？", "cue_sheet": "snd_voi_home_100101", "cue_id": 24, "motion_set": 0, "scene": 1, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_home_100101_0024", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}, {"character_id": 1001, "voice_id": 91015, "text": "うぅっ…内地の冬には負けない！\r\nなんて思ってましたけど、\r\nさ、寒いものは寒いですね～…！", "cue_sheet": "snd_voi_home_100101", "cue_id": 25, "motion_set": 1001809, "scene": 1, "use_gallery": 1, "card_id": 0, "lip_sync_data": "snd_voi_home_100101_0025", "lip_sync_flag": 0, "gender": 0, "motion_second_set": 0, "motion_second_start": 0, "gallery_key_usage_condition": 0, "prop_system_text_id": 0, "start_date": 1614092400}]}