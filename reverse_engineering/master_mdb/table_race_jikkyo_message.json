{"table": "race_jikkyo_message", "total_rows": 3249, "exported": 100, "columns": ["id", "group_id", "message", "voice", "per", "comment_group", "reuse", "omit_tag"], "data": [{"id": 1, "group_id": 100000, "message": "晴れわたる空のもと行われる、\\n%course\\n%ground%distance%race\\n%h_num_noウマ娘たちが挑みます", "voice": "1000101|%course|%ground|%distance|%race|%h_num_no", "per": 100, "comment_group": 0, "reuse": 0, "omit_tag": 0}, {"id": 2, "group_id": 100001, "message": "曇り空のもと、%course\\n%ground%distance%race\\n%h_num_noウマ娘たちが挑みます", "voice": "1000201|%course|%ground|%distance|%race|%h_num_no", "per": 100, "comment_group": 0, "reuse": 0, "omit_tag": 0}, {"id": 3, "group_id": 100002, "message": "足元悪い雨の中、%course\\n%ground%distance%race\\n%h_num_noウマ娘たちが挑みます", "voice": "1000301|%course|%ground|%distance|%race|%h_num_no", "per": 100, "comment_group": 0, "reuse": 0, "omit_tag": 0}, {"id": 5, "group_id": 100004, "message": "抜けるような青空のもと%course\\n%ground%distance%race\\n%h_num_noウマ娘たちが挑みます", "voice": "1000501|%course|%ground|%distance|%race|%h_num_no", "per": 100, "comment_group": 0, "reuse": 0, "omit_tag": 0}, {"id": 6, "group_id": 100005, "message": "波乱の香り漂う曇り空のもと行われる\\n%course\\n%ground%distance%race\\n%h_num_noウマ娘たちが挑みます", "voice": "1000601|%course|%ground|%distance|%race|%h_num_no", "per": 100, "comment_group": 0, "reuse": 0, "omit_tag": 0}, {"id": 7, "group_id": 100006, "message": "天が与えた試練の雨が、波乱含みの\\n%course\\n%ground%distance%race\\nいよいよ出走です", "voice": "1000701|%course|%ground|%distance|%race|1000702", "per": 100, "comment_group": 0, "reuse": 0, "omit_tag": 0}, {"id": 8, "group_id": 100007, "message": "寒さ続く%course、\\n試練が待ち受けていた\\n雪降る%race\\n%ground%distance\\n勝利にたどりつくのはどのウマ娘だ！", "voice": "1000801|%course|1000802|%c_0.02|%race|%ground|%distance|1000803", "per": 100, "comment_group": 0, "reuse": 0, "omit_tag": 0}, {"id": 9, "group_id": 100008, "message": "美しい青空が広がる、%course\\nターフも絶好の良バ場になりました！", "voice": "1001101|%course|1001102", "per": 100, "comment_group": 100000, "reuse": 0, "omit_tag": 0}, {"id": 10, "group_id": 100009, "message": "輝く太陽のもとに開かれている、\\n%course\\n良と発表されたバ場には、砂塵が舞っています", "voice": "1001201|%course|1001202", "per": 100, "comment_group": 100001, "reuse": 0, "omit_tag": 0}, {"id": 11, "group_id": 100010, "message": "ゆったりと流れる美しい雲\\n青空広がる、%course\\n前日に降った雨のため\\n絶好とはいえない稍重発表となりました", "voice": "1001301|%c_0.02|%course|1001302", "per": 100, "comment_group": 100002, "reuse": 0, "omit_tag": 0}, {"id": 12, "group_id": 100011, "message": "晴天のもとに開催される、%course\\n降っては止みを繰り返した天気のため\\nバ場状態は稍重の発表です", "voice": "1001401|%c_0.02|%course|1001402", "per": 100, "comment_group": 100003, "reuse": 0, "omit_tag": 0}, {"id": 13, "group_id": 100012, "message": "上空には灰色の空が広がる、\\n%course\\n天気はなんとか持ちこたえ、良バ場の発表です", "voice": "1001501|%course|1001502", "per": 100, "comment_group": 100004, "reuse": 0, "omit_tag": 0}, {"id": 15, "group_id": 100014, "message": "どんよりした雲が空を覆う\\n%course\\nこの空を映したように芝は稍重の発表となりました", "voice": "1001701|%c_0.02|%course|1001702", "per": 100, "comment_group": 100006, "reuse": 0, "omit_tag": 0}, {"id": 16, "group_id": 100015, "message": "時折雨が落ちる、%course\\n天の気まぐれにより、\\nバ場の引き締まった稍重発表となりました", "voice": "1001801|%course|1001802", "per": 100, "comment_group": 100007, "reuse": 0, "omit_tag": 0}, {"id": 17, "group_id": 100016, "message": "あいにくの雨が芝を濡らす、\\n%course\\nバ場状態の発表は重となってしまいました", "voice": "1001901|%course|1001902", "per": 100, "comment_group": 100008, "reuse": 0, "omit_tag": 0}, {"id": 18, "group_id": 100017, "message": "天から涙がこぼれる、%course\\n重バ場発表となってしまったダートで\\n過酷なレースが行われることとなりました", "voice": "1002001|%course|1002002", "per": 100, "comment_group": 100009, "reuse": 0, "omit_tag": 0}, {"id": 19, "group_id": 100018, "message": "荒れた天候の、%course\\n降り続いた雨がバ場状態を悪化させ\\n不良の発表となってしまいました", "voice": "1002101|%course|1002102", "per": 100, "comment_group": 100010, "reuse": 0, "omit_tag": 0}, {"id": 20, "group_id": 100019, "message": "強い雨の、%course\\n雨で濡れた砂はヌルリと滑る\\n不良バ場となってしまいました！", "voice": "1002201|%course|1002202", "per": 100, "comment_group": 100011, "reuse": 0, "omit_tag": 0}, {"id": 21, "group_id": 100020, "message": "昨日から続く雪がちらつく、\\n%course\\n除雪が終わった芝コースの状態は稍重となりました", "voice": "1002301|%course|1002302", "per": 100, "comment_group": 100012, "reuse": 0, "omit_tag": 0}, {"id": 22, "group_id": 100021, "message": "曇天から降り注ぐ雪の中、ウマ娘たちは走ります\\n%course、\\nダートコースは稍重の発表です", "voice": "1002401|%course|1002402", "per": 100, "comment_group": 100013, "reuse": 0, "omit_tag": 0}, {"id": 23, "group_id": 100022, "message": "舞い散る雪がターフを白く染めあげます\\n除雪作業の進むここ、%course\\nバ場状態の発表は重です", "voice": "1002501|%course|1002502", "per": 100, "comment_group": 100014, "reuse": 0, "omit_tag": 0}, {"id": 24, "group_id": 100023, "message": "灰色の空から舞い散る雪という名の白い天使たち\\n%course、\\nダートコースは重の発表です", "voice": "1002601|%c_0.05|%course|1002602", "per": 100, "comment_group": 100015, "reuse": 0, "omit_tag": 0}, {"id": 25, "group_id": 100200, "message": "ファンファーレが高らかに響く！\\n春のGⅠ開幕戦、フェブラリーステークス！", "voice": "1088701", "per": 100, "comment_group": 0, "reuse": 0, "omit_tag": 0}, {"id": 26, "group_id": 100201, "message": "オオカン桜が見守るもとでの熱き戦い！\\n電撃6ハロン、高松宮記念！", "voice": "1088801", "per": 100, "comment_group": 0, "reuse": 0, "omit_tag": 0}, {"id": 27, "group_id": 100202, "message": "早春の阪神に最強を自負するウマ娘が集う！\\n春の中・長距離三冠、第一弾、大阪杯！", "voice": "1088901", "per": 100, "comment_group": 0, "reuse": 0, "omit_tag": 0}, {"id": 28, "group_id": 100203, "message": "咲き誇る桜が女王の誕生を待ち望む！\\nクラシック第一弾！桜花賞！", "voice": "1089001", "per": 100, "comment_group": 0, "reuse": 0, "omit_tag": 0}, {"id": 29, "group_id": 100204, "message": "最も『はやい』ウマ娘が勝つという皐月賞！\\n成長を見せつけるのは誰だ！", "voice": "1089101", "per": 100, "comment_group": 0, "reuse": 0, "omit_tag": 0}, {"id": 30, "group_id": 100205, "message": "唯一無二、一帖の盾をかけた熱き戦い！\\n最長距離GⅠ天皇賞（春）！", "voice": "1089201", "per": 100, "comment_group": 0, "reuse": 0, "omit_tag": 0}, {"id": 31, "group_id": 100206, "message": "世代最速を自負するウマ娘が府中に集う！\\nNHKマイルカップ！", "voice": "1089301", "per": 100, "comment_group": 0, "reuse": 0, "omit_tag": 0}, {"id": 32, "group_id": 100207, "message": "女神見守る府中に天使が舞い降りる！\\nヴィクトリアに見初められた者が勝者となる！", "voice": "1089401", "per": 100, "comment_group": 0, "reuse": 0, "omit_tag": 0}, {"id": 33, "group_id": 100208, "message": "樫の女王を目指すウマ娘が府中に集う！\\nオークスで戴冠するのは誰だ！", "voice": "1089501", "per": 100, "comment_group": 0, "reuse": 0, "omit_tag": 0}, {"id": 34, "group_id": 100209, "message": "すべてのウマ娘が目指す頂点、日本ダービー！\\n歴史に蹄跡を残すのは誰だ！", "voice": "1089601", "per": 100, "comment_group": 0, "reuse": 0, "omit_tag": 0}, {"id": 35, "group_id": 100210, "message": "快速自慢が集う東京マイル・安田記念！\\n春のマイル王は誰の手に！", "voice": "1089701", "per": 100, "comment_group": 0, "reuse": 0, "omit_tag": 0}, {"id": 36, "group_id": 100211, "message": "票に託されたファンの夢\\n思いを力にかえて走るグランプリ・宝塚記念！", "voice": "1089801", "per": 100, "comment_group": 0, "reuse": 0, "omit_tag": 0}, {"id": 37, "group_id": 100212, "message": "秋の気配が近づく中山に快速自慢が集う！\\n電光石火・スプリンターズステークス！", "voice": "1089901", "per": 100, "comment_group": 0, "reuse": 0, "omit_tag": 0}, {"id": 38, "group_id": 100213, "message": "賑やかな秋を彩る秋華たち\\n秋華賞の舞台で美しく華を咲かせるのは誰だ！", "voice": "1090001", "per": 100, "comment_group": 0, "reuse": 0, "omit_tag": 0}, {"id": 39, "group_id": 100214, "message": "クラシックロードの終着点\\n菊花賞を制し最強の称号を手にするのは誰だ！", "voice": "1090101", "per": 100, "comment_group": 0, "reuse": 0, "omit_tag": 0}, {"id": 40, "group_id": 100215, "message": "ウマ娘たちが追い求める一帖の盾\\n鍛えた脚を武器に往く栄光への道！\\n天皇賞（秋）！", "voice": "1090201", "per": 100, "comment_group": 0, "reuse": 0, "omit_tag": 0}, {"id": 41, "group_id": 100216, "message": "日の丸とユニオンジャックに見守られ、\\n淀のターフでエリザベス女王杯を掲げるのは誰だ！", "voice": "1090301", "per": 100, "comment_group": 0, "reuse": 0, "omit_tag": 0}, {"id": 42, "group_id": 100217, "message": "長く続いたマイル路線も終わりを迎える\\n王者誕生！　マイルチャンピオンシップ！", "voice": "1090401", "per": 100, "comment_group": 0, "reuse": 0, "omit_tag": 0}, {"id": 43, "group_id": 100218, "message": "世界のウマ娘が栄光を求め\\nジャパンカップの府中に集う！\\n日本勢は対抗できるのか！", "voice": "1090501", "per": 100, "comment_group": 0, "reuse": 0, "omit_tag": 0}, {"id": 44, "group_id": 100219, "message": "砂上の戦いを求める猛者が集う！\\nダート王決定戦、チャンピオンズカップ！", "voice": "1090601", "per": 100, "comment_group": 0, "reuse": 0, "omit_tag": 0}, {"id": 45, "group_id": 100220, "message": "寒空の阪神に熱き心の若駒が揃う！\\nクラシックへの道、阪神ジュベナイルフィリーズ！", "voice": "1090701", "per": 100, "comment_group": 0, "reuse": 0, "omit_tag": 0}, {"id": 46, "group_id": 100221, "message": "クラシックへの登竜門\\n朝日杯フューチュリティステークス！\\nここから道ははじまる！", "voice": "1090801", "per": 100, "comment_group": 0, "reuse": 0, "omit_tag": 0}, {"id": 47, "group_id": 100222, "message": "年末の中山で争われる夢のグランプリ・有馬記念！\\nあなたの夢、私の夢は叶うのか！", "voice": "1090901", "per": 100, "comment_group": 0, "reuse": 0, "omit_tag": 0}, {"id": 48, "group_id": 100223, "message": "誰をも魅了し、心を奪う希望の星が誕生する！\\nホープフルステークス！", "voice": "1091001", "per": 100, "comment_group": 0, "reuse": 0, "omit_tag": 0}, {"id": 49, "group_id": 100224, "message": "日々のトレーニングで力を蓄えたウマ娘たちが\\nついにレースの舞台におりたちます！\\nトレーニングレース！", "voice": "1092301", "per": 100, "comment_group": 0, "reuse": 0, "omit_tag": 0}, {"id": 50, "group_id": 100225, "message": "可能性を秘めたウマ娘たちが\\nはじめて本番の舞台に立つ！\\nビギナー戦スタート！", "voice": "1091101", "per": 100, "comment_group": 0, "reuse": 0, "omit_tag": 0}, {"id": 51, "group_id": 100226, "message": "最強と呼ばれる者ですら負けることはある\\n敗者復活戦から再起を図るのは誰だ！", "voice": "1091201", "per": 100, "comment_group": 0, "reuse": 0, "omit_tag": 0}, {"id": 52, "group_id": 100227, "message": "一勝をあげてもウマ娘に休む暇はない\\n新たな壁を突破するのは誰だ\\nヴァルゴレース！", "voice": "1091301", "per": 100, "comment_group": 0, "reuse": 0, "omit_tag": 0}, {"id": 53, "group_id": 100228, "message": "黄道に美しく輝くハマルのように\\n光を放つウマ娘は誰だ！\\nアリエスレース！", "voice": "1091401", "per": 100, "comment_group": 0, "reuse": 0, "omit_tag": 0}, {"id": 54, "group_id": 100229, "message": "旅人に北を教える美しき星座\\nウマ娘たちにも道しるべとなるのか！\\nカシオペアレース！", "voice": "1091501", "per": 100, "comment_group": 0, "reuse": 0, "omit_tag": 0}, {"id": 55, "group_id": 100230, "message": "美しく輝くベテルギウスのように\\n最も強い光となるのは誰だ！\\nオリオンレース！", "voice": "1091601", "per": 100, "comment_group": 0, "reuse": 0, "omit_tag": 0}, {"id": 56, "group_id": 100231, "message": "トゥインクル・シリーズからの刺客\\n%legend\\nついにレジェンドを打ち負す者が現れるのか！？", "voice": "1091701|%legend|1091702", "per": 100, "comment_group": 0, "reuse": 0, "omit_tag": 0}, {"id": 57, "group_id": 100300, "message": "スピード自慢の快足ウマ娘たちが\\n新潟1000ｍに集う", "voice": "1034601", "per": 100, "comment_group": 0, "reuse": 0, "omit_tag": 0}, {"id": 58, "group_id": 100800, "message": "現在、1番人気は%a_h_pop1", "voice": "%w_0.3|1002701|%a_h_pop1", "per": 100, "comment_group": 0, "reuse": 0, "omit_tag": 0}, {"id": 59, "group_id": 100800, "message": "このレース、最も人気を集めているのは\\n%a_h_pop1、1番人気です", "voice": "1002801|%a_h_pop1|1002802", "per": 100, "comment_group": 0, "reuse": 0, "omit_tag": 0}, {"id": 60, "group_id": 100800, "message": "さあ、1番人気の紹介です\\n%a_h_pop1", "voice": "1002901|%a_h_pop1", "per": 100, "comment_group": 0, "reuse": 0, "omit_tag": 0}, {"id": 61, "group_id": 100800, "message": "1番人気はもちろんこの娘\\n%a_h_pop1", "voice": "%w_0.3|1003001|%a_h_pop1", "per": 100, "comment_group": 0, "reuse": 0, "omit_tag": 0}, {"id": 62, "group_id": 100802, "message": "続く2番人気は%a_h_pop2", "voice": "%w_0.3|1003101|%a_h_pop2", "per": 100, "comment_group": 0, "reuse": 0, "omit_tag": 0}, {"id": 63, "group_id": 100802, "message": "2番人気を紹介しましょう\\n%a_h_pop2", "voice": "%w_0.3|1003201|%a_h_pop2", "per": 100, "comment_group": 0, "reuse": 0, "omit_tag": 0}, {"id": 64, "group_id": 100802, "message": "実力は負けていません\\n2番人気、%a_h_pop2", "voice": "%w_0.3|1003301|%a_h_pop2", "per": 100, "comment_group": 0, "reuse": 0, "omit_tag": 0}, {"id": 65, "group_id": 100802, "message": "この評価は少し不満か？\\n2番人気はこの娘、%a_h_pop2", "voice": "%w_0.1|1003401|%a_h_pop2", "per": 100, "comment_group": 0, "reuse": 0, "omit_tag": 0}, {"id": 66, "group_id": 100803, "message": "2番人気を紹介しましょう\\n%a_h_pop2", "voice": "%w_0.3|1003201|%a_h_pop2", "per": 100, "comment_group": 0, "reuse": 0, "omit_tag": 0}, {"id": 67, "group_id": 100803, "message": "この評価は少し不満か？\\n2番人気はこの娘、%a_h_pop2", "voice": "%w_0.1|1003401|%a_h_pop2", "per": 100, "comment_group": 0, "reuse": 0, "omit_tag": 0}, {"id": 68, "group_id": 100804, "message": "3番人気には%a_h_pop3", "voice": "%w_0.3|1003501|%a_h_pop3", "per": 100, "comment_group": 0, "reuse": 0, "omit_tag": 0}, {"id": 69, "group_id": 100804, "message": "3番人気はこの娘です、%a_h_pop3", "voice": "%w_0.3|1003601|%a_h_pop3", "per": 100, "comment_group": 0, "reuse": 0, "omit_tag": 0}, {"id": 70, "group_id": 100804, "message": "虎視眈々と上位を狙っています\\n3番人気は%a_h_pop3", "voice": "%w_0.3|1003701|%a_h_pop3", "per": 100, "comment_group": 0, "reuse": 0, "omit_tag": 0}, {"id": 71, "group_id": 100804, "message": "人気と実力を兼ね備えた\\n%a_h_pop3\\n今日は3番人気です", "voice": "%w_0.3|1003801|%a_h_pop3|1003802", "per": 100, "comment_group": 0, "reuse": 0, "omit_tag": 0}, {"id": 72, "group_id": 100805, "message": "さあ、今日の主役はこのウマ娘をおいて他にいない\\n1番人気%a_h_pop1！", "voice": "%w_0.1|1003901|1003902|%w_0.01|%a_h_pop1", "per": 100, "comment_group": 0, "reuse": 0, "omit_tag": 0}, {"id": 73, "group_id": 100805, "message": "威風堂々とスタートを待つのはこのウマ娘\\n本日の1番人気%a_h_pop1！", "voice": "%w_0.1|1003903|1003904|%a_h_pop1", "per": 100, "comment_group": 0, "reuse": 0, "omit_tag": 0}, {"id": 74, "group_id": 100805, "message": "スタンドに押しかけた\\nファンの期待を一身に背負って\\n1番人気%a_h_pop1！", "voice": "%w_0.1|1003905|1003906|%a_h_pop1", "per": 100, "comment_group": 0, "reuse": 0, "omit_tag": 0}, {"id": 75, "group_id": 100805, "message": "さあ、今日の主役はこのウマ娘をおいて他にいない\\n本日の1番人気%a_h_pop1！", "voice": "%w_0.1|1003901|1003904|%a_h_pop1", "per": 100, "comment_group": 0, "reuse": 0, "omit_tag": 0}, {"id": 76, "group_id": 100805, "message": "威風堂々とスタートを待つのはこのウマ娘\\n1番人気%a_h_pop1！", "voice": "%w_0.1|1003903|1003906|%a_h_pop1", "per": 100, "comment_group": 0, "reuse": 0, "omit_tag": 0}, {"id": 77, "group_id": 100805, "message": "スタンドに押しかけた\\nファンの期待を一身に背負って\\n1番人気%a_h_pop1！", "voice": "%w_0.1|1003905|1003902|%a_h_pop1", "per": 100, "comment_group": 0, "reuse": 0, "omit_tag": 0}, {"id": 78, "group_id": 100805, "message": "さあ、今日の主役は\\nこのウマ娘をおいて他にいない\\n1番人気%a_h_pop1！", "voice": "%w_0.1|1003901|1003906|%a_h_pop1", "per": 100, "comment_group": 0, "reuse": 0, "omit_tag": 0}, {"id": 80